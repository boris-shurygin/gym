#!/usr/bin/env python3
"""Передай краткоживущий IAM Docker CLI через stdout helper, не сохраняй токен."""
import json
import os
import sys

if (sys.argv[1:] != ['get'] or sys.stdin.readline().strip() != 'cr.yandex'
        or not os.environ.get('GYM_REGISTRY_IAM_TOKEN')):
    raise SystemExit(1)
json.dump({'Username': 'iam', 'Secret': os.environ['GYM_REGISTRY_IAM_TOKEN']}, sys.stdout)
